@@ -0,0 +1,83 @@
+import os,sys,subprocess,time,signal,urllib.request
+from pathlib import Path
+import kernel_service_bridge as bridge
+import kernel_fixtures as fixtures
+import common as r
+require,sha,read,save=r.require,r.sha,r.read,lambda p,v:r.write(p,v,exclusive=False)
+def cmd(argv, timeout=20):
+    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
+    if p.returncode:
+        raise RuntimeError(repr(argv) + ': ' + p.stderr[-2000:])
+    return p.stdout.strip()
+
+def same_owner(identity):
+    try:
+        return process_identity(identity['pid']) == identity
+    except (FileNotFoundError, ProcessLookupError):
+        return False
+
+def process_identity(pid):
+    fields = Path(f'/proc/{pid}/stat').read_text().split(') ', 1)[1].split()
+    return dict(pid=pid, start_ticks=int(fields[19]))
+
+def desktop_absent():
+    p = subprocess.run(['pgrep', '-x', 'ChatGPT|Codex'], capture_output=True, text=True, timeout=3)
+    if p.returncode != 1:
+        raise ValueError('fully quit Codex/ChatGPT before overhead qualification')
+
+def _retained_fetch(base, endpoint, headers=None):
+    with urllib.request.urlopen(urllib.request.Request(base + '/' + endpoint, headers=headers or {}), timeout=3) as r:
+        return (r.read(), dict(r.headers))
+
+def handle_signal(signum, frame):
+    raise RuntimeError('terminal signal ' + str(signum))
+
+helpers=sys.modules[__name__]
+def proc_identity(pid):
+    text = Path(f'/proc/{pid}/stat').read_text()
+    fields = text.rsplit(') ', 1)[1].split()
+    return dict(pid=pid, start_ticks=int(fields[19]), parent=int(fields[1]))
+
+def scan_group(pid, group, main_identity, manifest, arm):
+    require(helpers.process_identity(pid) == main_identity, 'Wrapper PID identity changed')
+    pids = [int(p) for p in (group / 'cgroup.procs').read_text().split()]
+    require(pid in pids and len(pids) <= 2, 'Unknown/multiple native processes in service cgroup')
+    observed, vanished = ([], [])
+    for process in pids:
+        try:
+            identity = proc_identity(process)
+            require(process == pid or identity['parent'] == pid, 'Native child parent differs')
+            require(helpers.bridge.cgroup(process) == group, 'Process cgroup changed')
+            executable = sha(Path(f'/proc/{process}/exe'))
+            allowed = {manifest['binaries'][arm]} if process == pid else {manifest['binaries'][arm], manifest['gzip_sha256']}
+            require(executable in allowed, 'Unknown native executable')
+            tids = sorted((int(p.name) for p in Path(f'/proc/{process}/task').iterdir()))
+            require(len(tids) <= (2 if process == pid else 1), 'Unexpected service/native thread count')
+            live = []
+            for tid in tids:
+                try:
+                    require(helpers.bridge.cgroup(tid) == group and os.sched_getaffinity(tid) == {2}, f'Thread resource mismatch: tid={tid}')
+                    live.append(tid)
+                except (FileNotFoundError, ProcessLookupError):
+                    vanished.append(tid)
+            try:
+                after = proc_identity(process)
+            except (FileNotFoundError, ProcessLookupError):
+                if process == pid:
+                    raise
+                vanished.append(process)
+                continue
+            require(identity == after, 'PID reused during native process scan')
+            require(process in live, 'Main process thread unavailable')
+            observed.append(dict(**identity, exe_sha256=executable, tids=live, affinity=[2]))
+        except (FileNotFoundError, ProcessLookupError):
+            if process == pid:
+                raise
+            vanished.append(process)
+    return dict(cgroup=str(group), processes=observed, vanished_during_scan=vanished, main_pid=pid, affinity=[2])
+
+HTTP_CALLS={}
+def fetch(base,endpoint,headers=None):
+    key='GET '+endpoint
+    HTTP_CALLS[key]=HTTP_CALLS.get(key,0)+1
+    return _retained_fetch(base,endpoint,headers)
