+import argparse,json,os,re,signal,subprocess,sys,time,uuid
+from pathlib import Path
+import nginx_common as n
+h=n.prior.helpers
+LABEL='research.slo.host02.NGINX.owner'
+def inspect_owned(name, nonce):
+    p = subprocess.run(['docker', 'inspect', name], capture_output=True, text=True, timeout=15)
+    if p.returncode:
+        if 'no such' in p.stderr.lower():
+            return None
+        raise RuntimeError(p.stderr)
+    value = json.loads(p.stdout)[0]
+    n.require(value['Config'].get('Labels', {}).get(LABEL) == nonce, 'NGINX ownership nonce differs')
+    return value
+
+def remove_owned(name, nonce):
+    value = inspect_owned(name, nonce)
+    if value is not None:
+        h.cmd(['docker', 'rm', '-f', value['Id']])
+    n.require(inspect_owned(name, nonce) is None, 'Owned NGINX container remains')
+
+def watchdog(directory):
+    owner = n.read(directory / 'ownership.json')
+    while not (directory / 'cleanup.json').exists():
+        if not h.same_owner(owner['owner']) or time.monotonic() >= owner['deadline_monotonic']:
+            errors = []
+            path = directory / 'client-ownership.json'
+            if path.exists():
+                client = n.read(path)
+                if h.same_owner(client):
+                    try:
+                        os.killpg(client['pid'], signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+            try:
+                remove_owned(owner['container'], owner['nonce'])
+            except Exception as exc:
+                errors.append(str(exc))
+            n.save(directory / 'watchdog-cleanup.json', dict(invalidated=True, errors=errors))
+            if h.same_owner(owner['owner']):
+                os.kill(owner['owner']['pid'], signal.SIGTERM)
+            return
+        time.sleep(0.5)
+
+def parse_status(body):
+    pattern = b'Active connections: (\\d+)\\s+server accepts handled requests\\s+(\\d+) (\\d+) (\\d+)\\s+Reading: (\\d+) Writing: (\\d+) Waiting: (\\d+)\\s*'
+    match = re.fullmatch(pattern, body)
+    n.require(match is not None, 'Stock stub_status framing differs')
+    return dict(zip(('active', 'accepts', 'handled', 'requests', 'reading', 'writing', 'waiting'), (int(v) for v in match.groups())))
+
+def drained(value):
+    return value['active'] == 1 and value['reading'] == 0 and (value['writing'] == 1) and (value['waiting'] == 0)
+
+class Service:
+
+    def __init__(self, directory, performance):
+        self.directory, self.performance = (directory, performance)
+        self.name, self.nonce = ('quota-nginx-' + uuid.uuid4().hex, uuid.uuid4().hex)
+        self.started = time.monotonic()
+        self.client = self.watcher = None
+        self.image = n.read(n.SOFTWARE / 'image.json')['id']
+        self.manifest = n.read(n.SOFTWARE / 'manifest.json')
+        self.expected = None
+
+    def scan(self):
+        digest = self.manifest['nginx_sha256']
+        value = n.prior.scan_group(self.pid, self.group, self.main_identity, dict(binaries={'stock': digest}, gzip_sha256=digest), 'stock')
+        n.require(len(value['processes']) == 2 and (not value['vanished_during_scan']) and all((len(p['tids']) == 1 for p in value['processes'])), 'Stock master/worker process or thread set differs')
+        identities = {str(p['pid']): p['start_ticks'] for p in value['processes']}
+        if self.expected is not None:
+            n.require(identities == self.expected, 'NGINX worker respawn/PID identity changed')
+        return value
+
+    def guard(self):
+        n.require(time.monotonic() - self.started < 120, 'NGINX service active deadline')
+        if self.performance:
+            h.desktop_absent()
+        n.require(self.watcher.poll() is None, 'NGINX independent watchdog exited')
+        n.require({k: (self.group / k).read_text().strip() for k in n.LIMITS} == n.LIMITS, 'NGINX live limits changed')
+        return self.scan()
+
+    def start(self):
+        gate = self.directory / 'qualification'
+        gate.mkdir()
+        os.mkfifo(gate / 'start.fifo', 384)
+        n.save(self.directory / 'ownership.json', dict(owner=h.process_identity(os.getpid()), container=self.name, nonce=self.nonce, deadline_monotonic=self.started + 120))
+        self.watch_log = (self.directory / 'watchdog.log').open('x')
+        self.watcher = subprocess.Popen([sys.executable, '-B', __file__, 'watchdog', '--directory', str(self.directory)], stdout=self.watch_log, stderr=subprocess.STDOUT, start_new_session=True)
+        n.save(self.directory / "watchdog_process.json", h.process_identity(self.watcher.pid))
+        argv = ['docker', 'create', '--name', self.name, '--label', LABEL + '=' + self.nonce, '--user', n.PROTOCOL['application_user'], '--cpuset-cpus', '2', '--cpu-period', '100000', '--cpu-quota', '25000', '--memory', '512m', '--pids-limit', '128', '--read-only', '--tmpfs', '/tmp:rw,size=64m', '--mount', f'type=bind,src={gate},dst=/qualification,readonly', '-p', '127.0.0.1::8080', self.image]
+        h.cmd(argv)
+        h.cmd(['docker', 'start', self.name])
+        value = inspect_owned(self.name, self.nonce)
+        n.save(self.directory / 'container.json', dict(argv=argv, inspect=value))
+        n.require(value['Image'] == self.image, 'NGINX immutable image differs')
+        ports = value['NetworkSettings']['Ports']['8080/tcp']
+        n.require(len(ports) == 1 and ports[0]['HostIp'] == '127.0.0.1', 'NGINX private port publication differs')
+        self.base = 'http://127.0.0.1:' + ports[0]['HostPort']
+        self.pid = value['State']['Pid']
+        self.main_identity = h.process_identity(self.pid)
+        self.group = h.bridge.cgroup(self.pid)
+        n.require({k: (self.group / k).read_text().strip() for k in n.LIMITS} == n.LIMITS, 'NGINX initial limits differ')
+        n.save(self.directory / 'initial.json', dict(pid=self.pid, identity=self.main_identity, cgroup=str(self.group), limits=n.LIMITS, namespaces=h.bridge.namespaces(self.pid), ancestors=h.bridge.ancestors(self.group)))
+        h.bridge.stopped(self.pid, state='S')
+        n.require((self.group / 'cgroup.procs').read_text().split() == [str(self.pid)], 'NGINX gate not sole process')
+        actual = {}
+        for name, digest in self.manifest['runtime_files_sha256'].items():
+            path = self.directory / 'packaged-check'
+            h.cmd(['docker', 'cp', self.name + ':/' + name, str(path)])
+            actual[name] = n.sha(path)
+            path.unlink()
+            n.require(actual[name] == digest, 'NGINX packaged runtime changed: ' + name)
+        n.save(self.directory / 'runtime-identity.json', actual)
+        h.bridge.release_fifo(gate / 'start.fifo')
+        until = time.monotonic() + 10
+        while len((self.group / 'cgroup.procs').read_text().split()) != 2:
+            if time.monotonic() > until:
+                raise TimeoutError('NGINX worker startup')
+            time.sleep(0.05)
+        snapshot = self.scan()
+        self.expected = {str(p['pid']): p['start_ticks'] for p in snapshot['processes']}
+        n.save(self.directory / 'process-identities.json', self.expected)
+        while True:
+            self.guard()
+            try:
+                self.status()
+                break
+            except OSError:
+                if time.monotonic() > until:
+                    raise TimeoutError('NGINX HTTP startup')
+                time.sleep(0.1)
+
+    def status(self):
+        body, _ = h.fetch(self.base, 'health')
+        return parse_status(body)
+
+    def collect(self, prefix, count):
+        argv = [str(n.SOFTWARE / 'client'), '--url', self.base + '/compress', '--prefix', prefix, '--count', str(count), '--interval-ns', '200000000']
+        with (self.directory / (prefix + '.json')).open('x') as output, (self.directory / (prefix + '.stderr')).open('x') as error:
+            self.client = subprocess.Popen(argv, stdout=output, stderr=error, start_new_session=True)
+            n.save(self.directory / 'client-ownership.json', h.process_identity(self.client.pid))
+            until = time.monotonic() + count / 5 + 12
+            try:
+                while self.client.poll() is None:
+                    self.guard()
+                    if time.monotonic() > until:
+                        raise TimeoutError('NGINX client drain')
+                    time.sleep(0.25)
+                n.require(self.client.returncode == 0, 'NGINX client failed')
