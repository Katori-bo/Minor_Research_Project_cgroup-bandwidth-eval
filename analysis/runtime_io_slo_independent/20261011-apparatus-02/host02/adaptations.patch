+import nginx_prediction_common as c
+def outcomes(client, cfg, prefix='measurement'):
+    count = cfg['count'] if prefix == 'measurement' else cfg['warmup_count']
+    interval = cfg['interval_ns']
+    c.require(client['Schema'] == 'nginx-client-v1' and client['Count'] == count and (client['IntervalNs'] == interval) and (len(client['Rows']) == count), 'Study client schedule/count contract differs')
+    records = []
+    for i, r in enumerate(client['Rows']):
+        c.require(r['ID'] == f'{prefix}-{i}' and r['ScheduledNs'] == i * interval, 'Missing, duplicate or foreign scheduled offer')
+        dropped = r['Error'] == 'client in-flight cap reached'
+        if not dropped:
+            c.require(r['DispatchNs'] >= r['ScheduledNs'], 'Invalid dispatch timestamp')
+        success = not r['Error'] and (not r['DecodeError']) and (r['Status'] == 200) and (r['EchoID'] == r['ID']) and (r['ContentEncoding'] == 'gzip') and (r['ContentType'] == 'application/x-ndjson') and (r['DecodedBytes'] == 1048576) and (r['DecodedSHA256'] == c.n.INPUT_SHA) and (0 < r['BodyBytes'] <= 2097152)
+        if success:
+            c.require(r['ScheduledNs'] <= r['DispatchNs'] <= r['HeadersNs'] <= r['BodyDoneNs'], 'Invalid complete-response milestones')
+        records.append(dict(id=r['ID'], success=success, dropped=dropped, e2e_ns=r['BodyDoneNs'] - r['ScheduledNs'] if success else None, dispatch_lag_ns=None if dropped else r['DispatchNs'] - r['ScheduledNs'], response_headers_observed=r['Status'] > 0))
+    return records
