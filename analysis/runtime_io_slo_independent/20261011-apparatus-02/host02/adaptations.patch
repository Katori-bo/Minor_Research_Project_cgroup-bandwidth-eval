+import nginx_common as n
+ROOT,BASE=n.ROOT,n.BASE
+sha,read,save,require=n.sha,n.read,n.save,n.require
+PROTOCOL=dict(calibration_interval_ns=200000000,calibration_offers=400,pilot_offers=100,preparation_offers=20,
+ validation_intervals_ns=dict(A=250000000,B=166666667,C=125000000),validation_offers=300,
+ block_orders=['ABC','BCA','CAB','ACB','CBA','BAC'])
+def sources():return n.source_hashes()
+def config(role, index, profile=None, block=None):
+    require(role in ('preparation', 'pilot', 'calibration', 'validation'), 'Unknown study role')
+    require(isinstance(index, int) and index > 0, 'Invalid cohort index')
+    if role == 'calibration':
+        require(index <= 4 and profile is None and (block is None), 'Foreign calibration configuration')
+        interval, count = (PROTOCOL['calibration_interval_ns'], PROTOCOL['calibration_offers'])
+    else:
+        require(profile in PROTOCOL['validation_intervals_ns'], 'Foreign rate profile')
+        interval = PROTOCOL['validation_intervals_ns'][profile]
+        count = PROTOCOL[role + '_offers']
+        if role == 'validation':
+            require(block in range(1, 7) and index in range(1, 19) and (PROTOCOL['block_orders'][block - 1][(index - 1) % 3] == profile) and ((index - 1) // 3 + 1 == block), 'Validation order differs')
+        else:
+            require(index in range(1, 4) and profile == 'ABC'[index - 1] and (block is None), 'Qualification order differs')
+    return dict(role=role, index=index, profile=profile, block=block, interval_ns=interval, count=count, warmup_count=25)
+
+def configs(role):
+    if role == 'calibration':
+        return [config(role, i) for i in range(1, 5)]
+    if role in ('preparation', 'pilot'):
+        return [config(role, i, p) for i, p in enumerate('ABC', 1)]
+    return [config(role, (b - 1) * 3 + j, p, b) for b, order in enumerate(PROTOCOL['block_orders'], 1) for j, p in enumerate(order, 1)]
+
+def verify_evidence(directory):
+    seal = read(directory / 'evidence-seal.json')['files_sha256']
+    actual = {str(p.relative_to(directory)) for p in directory.rglob('*') if p.is_file() and p != directory / 'evidence-seal.json'}
+    require(actual == set(seal), 'Study evidence file set changed')
+    for name, digest in seal.items():
+        require(sha(directory / name) == digest, 'Study evidence changed: ' + name)
